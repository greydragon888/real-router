{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./*.tsx",
    "./*.mts",
    "./*.d.ts",
    "./vite/*.mts",
    "./apps/**/*"
  ],
  "files": [
    "shared/jsdom.d.ts"
  ],
  "exclude": [
    "./apps/preact.tsx",
    "./apps/solid.tsx"
  ]
}
