{
  "$schema": "./node_modules/turbo/schema.json",
  "futureFlags": {
    "globalConfiguration": true,
    "errorsOnlyShowHash": true,
    "affectedUsingTaskInputs": true,
    "watchUsingTaskInputs": true,
    "filterUsingTasks": true
  },
  "global": {
    "concurrency": "4",
    "passThroughEnv": ["CI", "GITHUB_ACTIONS"],
    "inputs": [
      "tsconfig.json",
      "prettier.config.*",
      "tsdown.base.*",
      "eslint.config.*",
      "vitest.config.*"
    ],
    "env": ["BENCH_ROUTER", "BENCH_NO_VALIDATE", "BENCH_SECTIONS"]
  },
  "tasks": {
    "bundle": {
      "dependsOn": ["^bundle"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**/*.{ts,tsx,vue,svelte}",
        "../../shared/**/*.ts",
        "tsdown.*",
        "rollup.*",
        "svelte.config.*",
        "ng-package.json",
        "scripts/**/*.mjs",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lib.json",
        "package.json"
      ],
      "env": ["NODE_ENV"],
      "outputLogs": "errors-only",
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^bundle",
        "bundle",
        "test",
        "test:properties",
        "lint",
        "lint:example"
      ],
      "inputs": [
        "src/**/*.{ts,tsx,vue,svelte,html,css}",
        "index.html",
        "vite.config.*",
        "angular.json",
        "tsconfig.json",
        "tsconfig.app.json",
        "package.json"
      ],
      "outputs": ["dist/**"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^bundle", "build"],
      "outputs": [],
      "inputs": [
        "src/**/*.{ts,tsx,vue,svelte}",
        "e2e/**/*.{ts,tsx}",
        "playwright.config.*",
        "index.html",
        "vite.config.*",
        "package.json"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test:stress": {
      "dependsOn": ["test:properties", "test", "type-check"],
      "outputs": [],
      "inputs": [
        "tests/stress/**/*.{ts,tsx}",
        "vitest.config.stress.*",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test:properties": {
      "dependsOn": ["type-check"],
      "outputs": [],
      "inputs": [
        "tests/property/**/*.{ts,tsx}",
        "vitest.config.properties.*",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test": {
      "dependsOn": ["type-check"],
      "outputs": ["coverage/**"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "../../shared/**/*.ts",
        "tests/**/*.{ts,tsx}",
        "vitest.config.*",
        "rollup.*",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "!**/node_modules/**"
      ],
      "env": ["NODE_ENV", "FORCE_COLOR"],
      "passThroughEnv": ["CI"],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,js,jsx}",
        "../../shared/**/*.ts",
        "!dist/**",
        "!coverage/**",
        "!**/node_modules/**",
        "eslint.config.*"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:example": {
      "dependsOn": ["^bundle"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,cjs}",
        "**/tsconfig*.json",
        "package.json",
        "!dist/**",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:bench": {
      "dependsOn": ["^bundle"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,cjs}",
        "**/tsconfig*.json",
        "eslint.config.*",
        "package.json",
        "!**/dist/**",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:fix": {
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,js,jsx}",
        "../../shared/**/*.ts",
        "!dist/**",
        "!coverage/**",
        "!**/node_modules/**",
        "eslint.config.*"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,vue,svelte}",
        "../../shared/**/*.ts",
        "!dist/**",
        "!**/node_modules/**",
        "rollup.*",
        "tsconfig.json",
        "**/tsconfig.json"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:package": {
      "dependsOn": ["bundle"],
      "outputs": [],
      "inputs": ["dist/**", "package.json"],
      "cache": true
    },
    "lint:types": {
      "dependsOn": ["bundle"],
      "outputs": [],
      "inputs": ["dist/**", "package.json"],
      "cache": true
    }
  }
}
