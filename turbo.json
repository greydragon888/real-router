{
  "$schema": "./node_modules/turbo/schema.json",
  "agentGuidance": false,
  "futureFlags": {
    "globalConfiguration": true,
    "errorsOnlyShowHash": true,
    "affectedUsingTaskInputs": false,
    "watchUsingTaskInputs": true,
    "filterUsingTasks": true,
    "experimentalObservability": true
  },
  "global": {
    "concurrency": "4",
    "passThroughEnv": ["CI", "GITHUB_ACTIONS"],
    "inputs": [
      "tsconfig.json",
      "prettier.config.*",
      "tsdown.base.*",
      "eslint.config.*",
      "vitest.config.*"
    ]
  },
  "tasks": {
    "bundle": {
      "dependsOn": ["^bundle"],
      "outputs": ["dist/**"],
      "inputs": [
        "src/**/*.{ts,tsx,svelte}",
        "tsdown.*",
        "rollup.*",
        "svelte.config.*",
        "ng-package.json",
        "scripts/**/*.mjs",
        "tsconfig.json",
        "tsconfig.build.json",
        "tsconfig.lib.json",
        "package.json",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/vitest.config.*"
      ],
      "env": ["NODE_ENV"],
      "outputLogs": "errors-only",
      "cache": true
    },
    "build": {
      "dependsOn": ["^bundle", "bundle", "test", "test:properties", "lint"],
      "inputs": ["src/**/*.{ts,tsx,svelte}", "tsconfig.json", "package.json"],
      "cache": true
    },
    "test:stress": {
      "dependsOn": ["test:properties", "test", "type-check"],
      "outputs": [],
      "inputs": [
        "tests/stress/**/*.{ts,tsx}",
        "vitest.config.stress.*",
        "!**/node_modules/**",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/tsdown.base.*"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test:properties": {
      "dependsOn": ["type-check"],
      "outputs": [],
      "inputs": [
        "tests/property/**/*.{ts,tsx}",
        "vitest.config.properties.*",
        "!**/node_modules/**",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/tsdown.base.*"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "test": {
      "dependsOn": ["type-check"],
      "outputs": ["coverage/**", ".vitest/blob/**"],
      "inputs": [
        "src/**/*.{ts,tsx}",
        "../../scripts/lib/**",
        "tests/**/*.{ts,tsx}",
        "vitest.config.*",
        "rollup.*",
        "**/*.test.{ts,tsx}",
        "**/*.spec.{ts,tsx}",
        "!**/node_modules/**",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/tsdown.base.*"
      ],
      "env": ["NODE_ENV", "FORCE_COLOR"],
      "passThroughEnv": ["CI"],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,js,jsx,svelte}",
        "../../scripts/lib/**",
        "!dist/**",
        "!coverage/**",
        "!**/node_modules/**",
        "!**/.svelte-kit/**",
        "!**/.vitest-cache/**",
        "eslint.config.*",
        "!$TURBO_ROOT$/tsdown.base.*",
        "!$TURBO_ROOT$/vitest.config.*"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:bench": {
      "dependsOn": ["^type-check", "type-check:bench"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,mts,cts,js,jsx,cjs,svelte}",
        "**/tsconfig*.json",
        "eslint.config.*",
        "package.json",
        "!**/dist/**",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:fix": {
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,js,jsx,svelte}",
        "../../shared/**/*.ts",
        "../../scripts/lib/**",
        "!dist/**",
        "!coverage/**",
        "!**/node_modules/**",
        "eslint.config.*"
      ],
      "cache": false
    },
    "type-check": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,svelte}",
        "../../scripts/lib/**",
        "!dist/**",
        "!**/node_modules/**",
        "!**/.svelte-kit/**",
        "!**/.vitest-cache/**",
        "rollup.*",
        "tsconfig.json",
        "**/tsconfig.json",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/tsdown.base.*",
        "!$TURBO_ROOT$/vitest.config.*"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "type-check:bench": {
      "dependsOn": ["^type-check"],
      "outputs": [],
      "inputs": [
        "**/*.{ts,tsx,mts,cts}",
        "**/tsconfig*.json",
        "package.json",
        "!**/dist/**",
        "!**/node_modules/**"
      ],
      "outputLogs": "errors-only",
      "cache": true
    },
    "lint:package": {
      "dependsOn": ["bundle"],
      "outputs": [],
      "inputs": ["dist/**", "package.json"],
      "cache": true
    },
    "lint:types": {
      "dependsOn": ["bundle"],
      "outputs": [],
      "inputs": ["dist/**", "package.json"],
      "cache": true
    },
    "//#test:tooling": {
      "inputs": [
        "scripts/**",
        ".github/**",
        ".husky/*",
        ".changeset/*.mjs",
        "package.json",
        "turbo.json",
        "!$TURBO_ROOT$/eslint.config.*",
        "!$TURBO_ROOT$/prettier.config.*",
        "!$TURBO_ROOT$/tsdown.base.*",
        "!$TURBO_ROOT$/vitest.config.*"
      ],
      "env": ["TOOLING_RUNTIME", "CI", "ImageOS", "ImageVersion"],
      "outputs": [],
      "outputLogs": "errors-only",
      "cache": true
    }
  }
}
