#!/bin/sh

# Pre-push hook: artifact validation before pushing
#
# - push guard: Every branch this push updates must receive HEAD, and the
#               tree must be clean — the steps read the WORKING TREE, so it
#               must be what is pushed. Checked first, and again before ✅
# - lint:changeset: Validate pending changeset files (fast fail-fast, first
#                   of the checks; no files → no-op)
# - lint:duplicates: Copy-paste detection (jscpd)
# - lint:doc-dup: Docblock sentences that restate the package's own docs
# - scripts tests: The repo's own tooling tests (scripts/*.test.mjs), the
#                  suite CI's Repo Lints runs
# - build: Final build to ensure compilation
# - test:stress: Heap/timing stress suites, isolated at --concurrency=1 so
#                heap measurements are free of build contention (#1423)
# - lint:types: Validate TypeScript types in dist (arethetypeswrong)
# - lint:package: Validate package.json exports (publint)
# - lint:unused: Dead code detection (knip)
# - lint:deps: Dependency version consistency (syncpack)
# - lint:audit: Vulnerability scan (osv-scanner, mirrors GHSA database
#               used by GitHub Dependency Review; non-blocking if
#               osv-scanner is not installed locally, blocking if it is
#               older than the floor in scripts/check-deps-audit.sh)
# - lint:security: Diff-aware SAST (semgrep, fast local complement to cloud
#                  CodeQL; only NEW findings on the branch; non-blocking if
#                  semgrep is not installed locally)
# - lint:prose: Historiography in the Markdown corpus (vale; non-blocking if
#               vale is not installed locally)

set -e

echo "🚀 Running pre-push checks..."

# >>> push guard: start — scripts/pre-push-guard.test.mjs runs this block
# Every step below reads the WORKING TREE, not the commits being pushed, so
# refuse unless they are the same thing: each branch this push updates must
# receive HEAD, and nothing may be uncommitted — an unstaged fix or an
# untracked test would be validated here and never reach the remote. The key
# is the REMOTE ref: `git push origin HEAD~1:master` names HEAD~1 locally.
echo "🧾 Checking that this push is the working tree..."
HEAD_SHA=$(git rev-parse HEAD)
while read -r _ local_sha remote_ref _; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac # tags and other refs
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac        # branch deletion
  if [ "$local_sha" != "$HEAD_SHA" ]; then
    echo "❌ $remote_ref would get $(git rev-parse --short "$local_sha"), but HEAD is $(git rev-parse --short HEAD)."
    echo "   The checks validate the working tree, so they would validate another commit."
    exit 1
  fi
done
if [ -n "$(git status --porcelain)" ]; then
  echo "❌ Uncommitted or untracked files — the checks would validate code this push does not carry:"
  git status --short
  echo "   Commit or remove them, or push from a clean worktree."
  exit 1
fi
# <<< push guard: start

# Validate pending changeset files first — cheap (~10ms) static check, so it
# fails fast before the expensive build. No-op when .changeset/ holds no
# changesets (WIP/infra push).
echo "📝 Validating changesets..."
pnpm lint:changeset

# Check for code duplication
echo "📋 Checking for code duplication..."
pnpm lint:duplicates

# The OTHER duplication: a docblock sentence restating the package's own docs,
# which is a rule with two homes and goes stale in one of them. Baseline-based
# and pure Node — no binary to miss, so unlike lint:audit / lint:security /
# lint:prose it has no skip arm. Placed ahead of the build because it is ~4s
# static: a second copy is worth learning about before the minutes, not after.
echo "📚 Checking docblocks against the docs..."
pnpm lint:doc-dup

# The repo's own tooling tests — the shard planner's, the gate-completeness
# meta-test and the rest of scripts/*.test.mjs — the files and runner CI's
# Repo Lints uses. Infrastructure reaches master by direct push, where no
# ci.yml runs, so this is the one run such a change gets before it lands
# (#2359). Pure Node and a few seconds, so it sits ahead of the build like
# lint:doc-dup.
#
# ⚠ Run with git's repository variables unset. A push from a linked worktree
# exports GIT_DIR to this hook, and several of these tests build throwaway
# repositories: with GIT_DIR inherited, their `git init` / `git config` /
# `git worktree add` write to THIS repository instead (core.bare=true and a
# test identity in .git/config — see IMPLEMENTATION_NOTES).
echo "🧰 Testing repo scripts..."
# shellcheck disable=SC2046 # the names must split: one operand per variable
(unset $(git rev-parse --local-env-vars); node --test --test-reporter=dot scripts/*.test.mjs)

# Build packages and validate published artifacts
echo "📦 Building packages..."
pnpm turbo run build lint:package lint:types --filter='!./examples/**'

# Heap/timing stress suites — run isolated at --concurrency=1 (they were
# dropped from build.dependsOn in #1423). Under the concurrent build, up to 4
# heap-sensitive suites ran in parallel and their heapUsed thresholds flaked
# from GC/CPU contention; serialized they measure clean. This is stress's only
# gate — CI/post-merge exclude it by design (see IMPLEMENTATION_NOTES).
echo "🧪 Running stress tests (isolated)..."
pnpm test:stress

# Check for unused code
echo "🧹 Checking for unused code..."
pnpm lint:unused

# Check dependency version consistency
echo "🔗 Checking dependency versions..."
pnpm lint:deps

# Vulnerability scan against GHSA database
echo "🔒 Auditing dependencies for known vulnerabilities..."
pnpm lint:audit

# Diff-aware SAST on the pushed source (fast local complement to cloud CodeQL)
echo "🔎 Running SAST diff scan (semgrep)..."
pnpm lint:security

# Historiography in the Markdown corpus. Advisory here — it SKIPS without Vale,
# like lint:audit and lint:security; the authoritative run is CI's Repo Lints,
# which sets VALE_REQUIRED=1 so a broken install cannot report a clean corpus.
echo "📝 Linting Markdown prose..."
pnpm lint:prose

# >>> push guard: end — scripts/pre-push-guard.test.mjs runs this block
# The steps above took minutes; the tree they read must still be this push.
if [ "$(git rev-parse HEAD)" != "$HEAD_SHA" ] || [ -n "$(git status --porcelain)" ]; then
  echo "❌ The working tree changed while the checks ran — they validated something other than this push."
  exit 1
fi
# <<< push guard: end

echo "✅ All pre-push checks passed! Pushing to remote..."
