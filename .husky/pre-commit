#!/bin/sh

# Exit on any error
set -e

echo "🔍 Running pre-commit checks..."

# Node-major drift guard (WARNING only, never blocks). A local major other than
# the one CI runs silently changes host-provided globals: Node >= 26 ships Web
# Storage unflagged, which shadows jsdom's `sessionStorage` under vitest and made
# 7 adapter scroll tests fail locally while CI stayed green for ten days (see
# IMPLEMENTATION_NOTES "Adapter scroll tests mock sessionStorage"). Silent when
# the majors match.
if [ -f .nvmrc ]; then
  want_node="$(tr -d '[:space:]' < .nvmrc)"
  have_node="$(node -p 'process.versions.node.split(".")[0]')"
  if [ -n "$want_node" ] && [ "$want_node" != "$have_node" ]; then
    echo "⚠️  Node major $have_node ≠ .nvmrc ($want_node) — CI runs $want_node."
    echo "   Host globals may differ; a local-only failure here may not be real."
  fi
fi

# Auto-deduplicate lockfile if it's being committed.
# pnpm add/update don't dedupe automatically (pnpm/pnpm#7258),
# so we do it here to keep the lockfile clean.
if git diff --cached --name-only | grep -q 'pnpm-lock.yaml'; then
  echo "🔗 Auto-deduplicating lockfile..."
  pnpm dedupe
  git add pnpm-lock.yaml
fi

# Check dependency version consistency across workspace packages (~1s).
# Catches sub-package version drift at commit time instead of waiting for
# pre-push. Pure static check (no install), so it's cheap enough to run
# unconditionally.
echo "🔗 Checking dependency versions..."
pnpm lint:deps

# Coverage-scope drift guard — keeps codecov.yml components + Sonar coverage
# exclusions in sync with the package set (#732). Cheap static check, so it
# runs before the expensive turbo test pipeline (fail-fast).
echo "📊 Checking coverage scope..."
pnpm lint:coverage-scope

# The #2092 claim ledger. It lives as a vitest test in core, and core's `test`
# task lists `src/**`, `../../shared/**/*.ts` and `tests/**` as inputs while the
# census SCANS 521 code files and 119 docs — every other package's `src` and the
# whole Markdown corpus are outside the cache key, so turbo replays a PASS and
# the ratchet never fires. Measured twice in one session: an
# `IMPLEMENTATION_NOTES.md` entry (which CLAUDE.md requires of every
# infrastructure change) and a first `⚠` in `packages/solid/src` both shipped
# red. Run here rather than widening the inputs: widening makes core's
# 5196-test suite rerun on any package's src edit, and this is 236 ms.
#
# ⚠ Not `claim-census.mjs --diff` — measured, it exits 0 on a file that carries
# claims and was never in the ledger, which is exactly the shape that shipped.
echo "📜 Checking the claim ledger..."
pnpm lint:claims

# The prototype-term census, run here for the SAME reason and it is the sharper
# case: the sites it scans live in four packages, and the one that drifted last
# (#2207) was in `persistent-params-plugin`, which core's `test` inputs do not
# name at all. A PR touching only that package replays core's cached pass.
echo "🧬 Checking the prototype-term census..."
pnpm lint:proto-terms

# The line-anchor ratchet, here for the SAME reason and it has now fired for real:
# it scans from the REPO ROOT, so every `.md` outside core is off the cache key.
# Measured 2026-09-10 — a `file.ts:259` anchor written into `IMPLEMENTATION_NOTES.md`
# passed pre-commit on a replayed core cache and shipped in `c1020c885`. The
# anchor rots by construction, which is the whole reason this ratchet exists.
echo "⚓ Checking the line-anchor ratchet..."
pnpm lint:anchors

# The angular dom-utils copy must not drift (#810 / #1838). ONE implementation,
# shared with `ci.yml` — the check used to live inline in the workflow only, so
# drift was committable locally and surfaced on the PR after a full CI round.
#
# Gated on the STAGED set, like the lockfile dedupe above, and that is not
# cosmetic: run unconditionally, the sync would regenerate the copy from a DIRTY
# unstaged shared/dom-utils and fail a commit that touches neither.
if git diff --cached --name-only |
  grep -qE '^(shared/dom-utils/|packages/angular/src/dom-utils/)'; then
  echo "🔁 Checking angular dom-utils copy..."
  node scripts/check-angular-dom-utils-sync.mjs
fi

# Run type checking, linting, and tests via turbo pipeline
# (turbo caching makes lint-staged redundant)
#
# `lint` is listed EXPLICITLY: it used to ride along as a `test` dependency, but
# that serialised it in front of every test run (core#lint alone is ~70 s on a CI
# runner, and nothing started until it finished). It is now a sibling task, so it
# runs in parallel with the tests instead of gating them. Dropping it from this
# line would silently stop linting on commit.
echo "🧪 Running tests + lint (type-check rides along via turbo)..."
pnpm turbo run test lint --filter='!./examples/**'

# Check that e2e directories have specs
# Cheap static check (find + wc) — catches forgotten e2e/ during scaffolding.
# lint:duplicates (jscpd) and lint:unused (knip) live in pre-push only —
# their analysis depends on the full tree, not on the current commit's diff.
echo "🎭 Checking e2e specs..."
pnpm lint:e2e

echo "✅ Pre-commit checks passed!"
