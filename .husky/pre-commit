#!/bin/sh

# Exit on any error
set -e

echo "🔍 Running pre-commit checks..."

# Node-major drift guard (WARNING only, never blocks). A local major other than
# the one CI runs silently changes host-provided globals: Node >= 26 ships Web
# Storage unflagged, which shadows jsdom's `sessionStorage` under vitest and made
# 7 adapter scroll tests fail locally while CI stayed green for ten days (see
# IMPLEMENTATION_NOTES "Adapter scroll tests mock sessionStorage"). Silent when
# the majors match.
if [ -f .nvmrc ]; then
  want_node="$(tr -d '[:space:]' < .nvmrc)"
  have_node="$(node -p 'process.versions.node.split(".")[0]')"
  if [ -n "$want_node" ] && [ "$want_node" != "$have_node" ]; then
    echo "⚠️  Node major $have_node ≠ .nvmrc ($want_node) — CI runs $want_node."
    echo "   Host globals may differ; a local-only failure here may not be real."
  fi
fi

# pnpm version guard (BLOCKS). `pmOnFail: ignore` in pnpm-workspace.yaml keeps
# the lockfile one YAML document, and it also turns off pnpm's switch to the
# version `packageManager` pins — pnpm 11 honours it too, so a global 11.x stays
# 11.x in this repository. The auto-dedupe below would then rewrite the lockfile
# with another pnpm. CI never hits this: pnpm/action-setup installs the pin.
want_pnpm="$(node -p 'require("./package.json").packageManager.split("@")[1].split("+")[0]')"
have_pnpm="$(pnpm --version)"
if [ "$want_pnpm" != "$have_pnpm" ]; then
  echo "❌ pnpm $have_pnpm is running here, but package.json pins pnpm $want_pnpm."
  echo "   pmOnFail: ignore keeps pnpm from switching by itself. Update it outside the repository:"
  echo "   cd ~ && pnpm self-update $want_pnpm"
  exit 1
fi

# Auto-deduplicate a lockfile that is being committed — the root's, the
# examples workspace's or the cross-router bench's, each in its own workspace.
# pnpm add/update don't dedupe automatically,
# so we do it here to keep the lockfile clean.
if git diff --cached --name-only | grep -qx 'pnpm-lock.yaml'; then
  echo "🔗 Auto-deduplicating lockfile..."
  pnpm dedupe
  git add pnpm-lock.yaml
fi
if git diff --cached --name-only | grep -qx 'examples/pnpm-lock.yaml'; then
  echo "🔗 Auto-deduplicating the examples lockfile..."
  pnpm --dir examples dedupe
  git add examples/pnpm-lock.yaml
fi
if git diff --cached --name-only | grep -qx 'cross-router-bench/pnpm-lock.yaml'; then
  echo "🔗 Auto-deduplicating the cross-router lockfile..."
  pnpm --dir cross-router-bench dedupe
  git add cross-router-bench/pnpm-lock.yaml
fi

# The checks: the pre-commit stage of `scripts/checks.mjs`, each with what it
# catches, run by `scripts/verify.mjs` in the registry's order. It keeps
# GIT_INDEX_FILE, so each check judges the index of the commit being made.
node scripts/verify.mjs --stage pre-commit

echo "✅ Pre-commit checks passed!"
