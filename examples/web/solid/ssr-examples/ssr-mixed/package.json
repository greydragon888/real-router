{
  "name": "ssr-mixed-solid-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "tsx server/dev.ts",
    "build:app": "tsc -b && vite build --outDir dist/client && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "0.25.0",
    "@real-router/core": "0.148.0",
    "@real-router/solid": "0.25.0",
    "@real-router/ssr-data-plugin": "0.6.0",
    "@real-router/ssr-utils": "0.3.0",
    "express": "5.2.1",
    "solid-js": "~1.9.14"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-solid": "2.11.14"
  }
}
