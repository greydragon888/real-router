{
  "name": "ssg-preact-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "vite",
    "build:app": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && tsx scripts/ssg-build.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "*",
    "@real-router/core": "*",
    "@real-router/preact": "*",
    "@real-router/ssr-data-plugin": "*",
    "@real-router/ssr-utils": "*",
    "preact": "~10.29.7",
    "preact-render-to-string": "~6.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
