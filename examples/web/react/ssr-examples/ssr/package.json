    "@real-router/react": "*",
    "@real-router/ssr-data-plugin": "*",
    "@real-router/ssr-utils": "*",
    "express": "5.2.1",
    "react": "~19.3.0",
    "react-dom": "~19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
