{
  "name": "ssr-mixed-vue-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "tsx server/dev.ts",
    "build:app": "vue-tsc -b && vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "*",
    "@real-router/core": "*",
    "@real-router/ssr-data-plugin": "*",
    "@real-router/ssr-utils": "*",
    "@real-router/vue": "*",
    "express": "5.2.1",
    "vue": "~3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@vitejs/plugin-vue": "6.0.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vue-tsc": "3.3.11"
  }
}
