{
  "name": "ssg-vue-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "vite",
    "build:app": "vue-tsc -b && vite build && vite build --ssr src/entry-server.ts --outDir dist/server && tsx scripts/ssg-build.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "*",
    "@real-router/core": "*",
    "@real-router/ssr-data-plugin": "*",
    "@real-router/ssr-utils": "*",
    "@real-router/vue": "*",
    "vue": "~3.5.39"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue-tsc": "3.3.13"
  }
}
