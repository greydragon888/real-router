    "@testing-library/vue": "~8.1.0",
    "@vitejs/plugin-vue": "6.0.9",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
