{
  "name": "ssg-svelte-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "vite",
    "build:app": "svelte-check && vite build && vite build --ssr src/entry-server.ts --outDir dist/server && tsx scripts/ssg-build.ts",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "0.25.0",
    "@real-router/core": "0.148.0",
    "@real-router/ssr-data-plugin": "0.6.0",
    "@real-router/ssr-utils": "0.3.0",
    "@real-router/svelte": "0.23.0",
    "svelte": "~5.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.13.5",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
