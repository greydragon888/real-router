{
  "name": "ssr-svelte-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm -w run use-checkout",
    "dev": "tsx server/dev.ts",
    "build:app": "svelte-check && vite build --outDir dist/client && vite build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "NODE_ENV=production tsx server/index.ts",
    "test:e2e": "playwright test",
    "lint:example": "eslint --cache . --max-warnings 0"
  },
  "dependencies": {
    "@real-router/browser-plugin": "*",
    "@real-router/core": "*",
    "@real-router/ssr-data-plugin": "*",
    "@real-router/ssr-utils": "*",
    "@real-router/svelte": "*",
    "express": "5.2.1",
    "svelte": "~5.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  }
}
